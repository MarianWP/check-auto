# Скопіюй у .env (він у .gitignore). Без цих змінних застосунок працює лише локально, без входу і хмари.
# Settings → API у проєкті Supabase:
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...
# Ім'я бота без @ (для Telegram Login Widget на сайті; у BotFather: /setdomain → marianwp.github.io):
VITE_TG_BOT=golfcheck_bot
